# setup.cmd creates your private .env only if it does not exist.
# Edit .env in Notepad. Never share it, upload it, or commit it to Git.
# Paste your own key after = (no spaces). Get one at https://console.groq.com/keys
# A key is needed for AI document processing, not for the website or accounts.
GROQ_API_KEY=
# Leave this default unless your Groq account requires another supported model.
GROQ_MODEL=openai/gpt-oss-120b

# Leave this path unchanged. Web app and optional worker share this database.
# Existing accounts and documents remain here across restarts.
IDP_DATABASE_PATH=data/operational/organization.db
# Website address is http://127.0.0.1:8000. Change only if that port is busy.
IDP_WEB_PORT=8000
